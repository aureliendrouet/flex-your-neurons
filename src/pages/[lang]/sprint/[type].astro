---
import Base from '../../../layouts/Base.astro';
import Quiz from '../../../components/Quiz';
import { ALL_META, getItemText, getMeta } from '../../../lib/generators';
import { typeHue } from '../../../lib/identity';
import { dict, LOCALES, type Locale } from '../../../lib/i18n';
import type { ItemTypeId } from '../../../lib/types';

/*
 * A route exists only for a format that may actually be sprinted. Generating a page for every
 * format and refusing to run it would advertise a block the runner will not honour, and a URL that
 * exists but does not work is worse than one that never existed.
 */
export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    ALL_META.filter((meta) => meta.sprintable).map((meta) => ({ params: { lang, type: meta.id } })),
  );
}

const locale = Astro.params.lang as Locale;
const type = Astro.params.type as ItemTypeId;
const t = dict(locale);
const meta = getMeta(type);
const text = getItemText(type, locale);
const p = t.pages.sprintType;

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  locale={locale}
  title={p.title(text.name)}
  description={p.description(text.name)}
  lede={p.lede}
  ogImage={`${root}/${locale}/og/${type}.svg`}
>
  <div
    class="cluster page-meta"
    style={`--cluster-gap: 0.5rem; --type-hue: ${typeHue(type)}`}
    data-type-identity={type}
  >
    <span class="pill pill--identity">{t.domains[meta.domain]} ({meta.domain})</span>
    <span class="pill">{p.window}</span>
  </div>

  <div class="card quiz-stage">
    <Quiz client:only="preact" mode="sprint" types={[type]} locale={locale} />
  </div>

  <section class="card prose-card">
    <h2 class="section-heading section-heading--xs">{p.aboutHeading}</h2>
    <p class="muted prose-card-body">{p.aboutBody}</p>
    <p class="muted prose-card-body">{text.description}</p>
  </section>
</Base>
