---
import Base from '../../layouts/Base.astro';
import { allItemTypes } from '../../lib/generators';
import { dict, LOCALES, type Locale } from '../../lib/i18n';
import type { ChcDomain } from '../../lib/types';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const p = t.pages.about;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${locale}/${path}`;

const domains: ChcDomain[] = ['Gf', 'Gv', 'Gwm', 'Gs'];
const types = allItemTypes(locale);
---

<Base locale={locale} title={p.title} description={p.description} lede={p.lede}>
  <div class="prose-sections">
    <section>
      <h2 class="section-heading">{p.procedureHeading}</h2>
      <p>{p.procedureP1}</p>
      <p>{p.procedureP2}</p>
      <ol class="muted">{p.procedureList.map((line) => <li>{line}</li>)}</ol>
      <p>{p.procedureP3}</p>
    </section>

    <section>
      <h2 class="section-heading">{p.chcHeading}</h2>
      <p>{p.chcP1}</p>
      <div class="card scroll-x about-table">
        <table class="data">
          <thead>
            <tr>
              <th>{p.chcColCode}</th>
              <th>{p.chcColAbility}</th>
              <th>{p.chcColFormats}</th>
            </tr>
          </thead>
          <tbody>
            {
              domains.map((d) => (
                <tr>
                  <td class="mono">{d}</td>
                  <td>{t.domains[d]}</td>
                  <td class="muted">
                    {types.filter((m) => m.domain === d).map((m) => m.name).join(', ')}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="muted small">{p.chcNote}</p>
    </section>

    <section>
      <h2 class="section-heading">{p.familiesHeading}</h2>
      <div class="card-stack">
        {
          p.families.map((f) => (
            <div class="card note-card">
              <strong>{f.name}</strong>
              <p class="muted note-card-body">{f.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="section-heading">{p.automationHeading}</h2>
      <p>{p.automationBody}</p>
    </section>

    <section>
      <h2 class="section-heading">{p.verbalHeading}</h2>
      <p>{p.verbalP1}</p>
      <p>{p.verbalP2}</p>
      <p class="muted">{p.verbalP3}</p>
    </section>

    <section>
      <h2 class="section-heading">{p.guardsHeading}</h2>
      <p>{p.guardsLede}</p>
      {
        p.guards.map((g) => (
          <div class="card note-card note-card--spaced">
            <strong>{g.title}</strong>
            <p class="muted note-card-body">{g.body}</p>
          </div>
        ))
      }
    </section>

    {
      /*
       * The proof, stepped out.
       *
       * Every stage is in the DOM and readable from the moment the page loads — the scroll
       * animation only stages the *reveal*, and it is entirely CSS behind an `@supports`
       * guard. With no scroll-driven animation support, no JavaScript, or reduced motion, the
       * whole thing is simply a set of visible panels, which is what it has to be: this is an
       * argument, and an argument that needs a scroll gesture to be legible is not an argument.
       */
    }
    <section class="proof" data-testid="proof">
      <h2 class="section-heading">{p.proof.heading}</h2>
      <p class="muted section-lede">{p.proof.lede}</p>

      <div class="proof-steps">
        <div class="proof-step proof-step--sequence">
          <p class="subtle proof-caption">{p.proof.sequence}</p>
          <div class="seq-row">
            {['2', '4', '8'].map((term) => <span class="seq-term">{term}</span>)}
            <span class="seq-term" data-blank="true">?</span>
          </div>
        </div>

        <div class="proof-step proof-reading" data-reading="a">
          <strong class="proof-reading-name">{p.proof.readingA}</strong>
          <p class="muted proof-reading-work">{p.proof.readingAWork}</p>
          <span class="seq-term proof-answer">{p.proof.readingAAnswer}</span>
        </div>

        <div class="proof-step proof-reading" data-reading="b">
          <strong class="proof-reading-name">{p.proof.readingB}</strong>
          <p class="muted proof-reading-work">{p.proof.readingBWork}</p>
          <span class="seq-term proof-answer">{p.proof.readingBAnswer}</span>
        </div>

        <div class="proof-step proof-verdict">
          <span class="tag proof-verdict-tag">{p.proof.verdictLabel}</span>
          <p class="proof-verdict-body">{p.proof.verdict}</p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="section-heading">{p.difficultyHeading}</h2>
      <p>{p.difficultyP1}</p>
      <p class="muted">{p.difficultyP2}</p>
      <p>{p.difficultyP3}</p>
    </section>

    <section>
      <h2 class="section-heading">{p.ceilingHeading}</h2>
      <p>{p.ceilingP1}</p>
      <p>{p.ceilingP2}</p>
      <p>{p.ceilingP3}</p>
    </section>

    <section>
      <h2 class="section-heading">{p.notMeasuredHeading}</h2>
      <p>{p.notMeasuredLede}</p>
      <div class="card-grid card-grid--fit about-not-measured" style="--card-min: 15rem; --card-gap: 0.85rem">
        {
          p.notMeasured.map((item) => (
            <div class="card note-card note-card--tight">
              <strong>{item.title}</strong>
              <p class="muted note-card-body">{item.body}</p>
            </div>
          ))
        }
      </div>
      <p>{p.notMeasuredClose}</p>
    </section>

    <section>
      <h2 class="section-heading">{p.limitsHeading}</h2>
      <div class="card-stack">
        {
          p.limits.map((l) => (
            <div>
              <strong>{l.title}</strong>
              <p class="muted note-card-body">{l.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="card note">
      <h2 class="section-heading section-heading--sm">{p.dataHeading}</h2>
      <p class="muted prose-card-body">
        {p.dataBodyBefore}<a href={href('progress/')}>{p.dataLink}</a>{p.dataBodyAfter}
      </p>
    </section>

    <section>
      <h2 class="section-heading">{p.sourcesHeading}</h2>
      <ul class="muted spaced-list small">
        {p.sources.map((line) => <li>{line}</li>)}
      </ul>
      <p class="subtle small">{p.sourcesNote}</p>
    </section>
  </div>
</Base>
