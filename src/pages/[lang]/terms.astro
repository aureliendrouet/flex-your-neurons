---
/**
 * Terms of use.
 *
 * The route segment stays `terms/` in both locales on purpose: `pathForLocale` swaps only
 * the locale segment, so a translated slug would break the language switcher on this page.
 * Only the label is localised.
 */
import Base from '../../layouts/Base.astro';
import { dict, LOCALES, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const p = dict(locale).pages.terms;
---

<Base locale={locale} title={p.title} description={p.description} lede={p.lede}>
  <div class="prose-sections prose-sections--tight">
    <p class="subtle small flush" data-testid="terms-updated">
      {p.updated}
    </p>

    {
      p.sections.map((section, i) => (
        <section data-terms-section={String(i + 1)}>
          <h2 class="section-heading section-heading--num">
            <span class="subtle section-number">{i + 1}.</span>{' '}
            {section.heading}
          </h2>
          {section.body.map((paragraph) => (
            <p class="terms-paragraph">{paragraph}</p>
          ))}
        </section>
      ))
    }

    <section class="card terms-publisher">
      <div>
        <strong>{p.publisherLabel}</strong>
        <p class="muted note-card-body" data-testid="terms-publisher">{p.publisher}</p>
      </div>
      <div>
        <strong>{p.contactLabel}</strong>
        <p class="muted note-card-body">
          <a href={p.contact} rel="noopener noreferrer" class="break-anywhere">
            {p.contact}
          </a>
        </p>
      </div>
      <div>
        <strong>{p.hostLabel}</strong>
        <p class="muted note-card-body">{p.host}</p>
      </div>
    </section>
  </div>
</Base>
