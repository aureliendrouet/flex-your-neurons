---
import Base from '../../../layouts/Base.astro';
import ItemThumb from '../../../components/ItemThumb';
import { allItemTypes } from '../../../lib/generators';
import { previewItem } from '../../../lib/previews';
import { dict, LOCALES, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const p = t.pages.practiceIndex;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${locale}/${path}`;
const types = allItemTypes(locale);
---

<Base locale={locale} title={p.title} description={p.description} lede={p.lede}>
  <div class="card-grid" style="--card-min: 20rem">
    {
      types.map((meta) => (
        <a
          class="card type-card practice-card"
          href={href(`practice/${meta.id}/`)}
          data-testid={`practice-card-${meta.id}`}
        >
          <ItemThumb item={previewItem(meta.id, locale)} />
          <div class="cluster practice-card-head" style="--cluster-gap: 0.6rem">
            <strong class="practice-card-name">{meta.name}</strong>
            <span class="pill practice-card-domain">{t.domains[meta.domain]}</span>
          </div>
          <p class="muted practice-card-blurb">{meta.blurb}</p>
        </a>
      ))
    }
  </div>
</Base>
