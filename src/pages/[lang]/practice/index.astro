---
import Base from '../../../layouts/Base.astro';
import ItemThumb from '../../../components/ItemThumb';
import { allItemTypes } from '../../../lib/generators';
import { previewItem } from '../../../lib/previews';
import { dict, LOCALES, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const p = t.pages.practiceIndex;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${locale}/${path}`;
const types = allItemTypes(locale);
---

<Base locale={locale} title={p.title} description={p.description} lede={p.lede}>
  <div style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));">
    {
      types.map((meta) => (
        <a
          class="card"
          href={href(`practice/${meta.id}/`)}
          data-testid={`practice-card-${meta.id}`}
          style="padding: 1.25rem; text-decoration: none; color: inherit; display: grid; gap: 0.4rem; align-content: start;"
        >
          <ItemThumb item={previewItem(meta.id, locale)} />
          <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
            <strong style="font-size: 1.05rem;">{meta.name}</strong>
            <span class="pill" style="margin-left: auto;">{t.domains[meta.domain]}</span>
          </div>
          <p class="muted" style="margin: 0; font-size: 0.94rem;">{meta.blurb}</p>
        </a>
      ))
    }
  </div>
</Base>
