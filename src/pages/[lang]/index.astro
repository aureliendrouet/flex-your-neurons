---
import Base from '../../layouts/Base.astro';
import FigureView from '../../components/FigureView';
import ItemThumb from '../../components/ItemThumb';
import Mascot from '../../components/Mascot';
import { allItemTypes, generateItem } from '../../lib/generators';
import { typeHue } from '../../lib/identity';
import { previewItem } from '../../lib/previews';
import { dict, LOCALES, type Locale } from '../../lib/i18n';
import type { ChcDomain } from '../../lib/types';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const p = t.pages.home;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${locale}/${path}`;

const types = allItemTypes(locale);
/*
 * Derived from the registry, never listed by hand. This page groups the format cards by domain, so
 * a hand-written list does not merely mislabel — it *drops every card* in an unlisted domain. That
 * is exactly what happened when the arithmetic format shipped with a new domain: Gq was absent
 * here, and the card vanished from the home page while every other page showed it.
 */
const domains: ChcDomain[] = [...new Set(types.map((m) => m.domain))];
const byDomain = domains.map((d) => ({
  domain: d,
  label: t.domains[d],
  types: types.filter((m) => m.domain === d),
}));

/*
 * The hero is a genuine, solvable matrix at a pinned seed — the same generator, the same
 * verification, the same drawing code as a live item. The page demonstrates the product
 * instead of describing it, and the demonstration cannot be faked: if the generator broke,
 * the home page would break with it.
 *
 * The seed is chosen, not arbitrary. At level 1 behind an h1 at 30% opacity, only one kind
 * of pattern survives: this one is a single shape carrying a single rule on *size*, which
 * stays obvious at any contrast — 5,4,3 / 4,3,2 / 3,2,? — where a shading ramp would have
 * been invisible at that weight and a five-attribute matrix would have been noise.
 */
const hero = generateItem('matrix', 'HERO151', 1, locale);
const heroCells = hero.stimulus.kind === 'matrix' ? hero.stimulus.cells : [];
---

<Base locale={locale} title={p.title} description={p.description} lede={p.lede}>
  <div slot="hero" class="hero-matrix" data-hero-seed={hero.seed}>
    {
      /* `--cell-index` is the only per-cell value: the stagger itself is in CSS, so the
         pattern resolves in sequence with no script. */
      heroCells.map((cell, i) => (
        <div class="hero-cell" data-blank={String(cell === null)} style={`--cell-index: ${i}`}>
          {cell !== null && <FigureView figure={cell} className="hero-figure" />}
        </div>
      ))
    }
  </div>
  <div class="cluster home-cta">
    <a class="btn btn-primary btn-lg" href={href('test/')} data-testid="cta-test">{p.ctaTest}</a>
    <a class="btn btn-lg" href={href('practice/')} data-testid="cta-practice">{p.ctaPractice}</a>
  </div>

  {
    /*
     * Below the buttons rather than beside the hero.
     *
     * The hero is a real, solvable matrix sitting behind the h1 at low contrast, and it is the
     * page's argument: the site demonstrates the product instead of describing it. Putting a
     * cartoon next to it would give the eye something louder to land on than the thing the layout
     * exists to show. Down here the mascot is the first warm thing after the decision has already
     * been offered, which is the job it was added to do.
     */
  }
  <Mascot locale={locale} moment="home" className="home-mascot" />

  <section class="home-section">
    <h2 class="section-heading">{p.whatHeading}</h2>
    <p class="muted section-lede">{p.whatLede}</p>

    <div class="domain-groups">
      {
        byDomain.map((group) => (
          <div>
            <h3 class="domain-heading">
              {group.label} <span class="domain-code">({group.domain})</span>
            </h3>
            {/* `--type-hue` paints each card's chrome only; it never reaches the figures
                inside the miniature. See src/lib/identity.ts. */}
            <div class="card-grid" style="--card-gap: 0.85rem">
              {group.types.map((meta) => (
                <a
                  class="card card--interactive type-card"
                  href={href(`practice/${meta.id}/`)}
                  data-testid={`type-card-${meta.id}`}
                  style={`--type-hue: ${typeHue(meta.id)}`}
                >
                  {/*
                   * A real item from this format, at a pinned seed, drawn by the same
                   * generator the drill uses. It replaces an emoji that told you nothing
                   * about what you were choosing.
                   */}
                  <ItemThumb item={previewItem(meta.id, locale)} locale={locale} />
                  <strong class="type-card-name">{meta.name}</strong>
                  <span class="muted type-card-blurb">{meta.blurb}</span>
                  <span class="subtle type-card-seen">{p.seenIn(meta.seenIn)}</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card home-how">
    <h2 class="section-heading section-heading--sm">{p.howHeading}</h2>
    <div class="card-grid card-grid--fit" style="--card-min: 15rem; --card-gap: 1.1rem">
      {
        p.how.map((point) => (
          <div>
            <strong>{point.title}</strong>
            <p class="muted home-how-body">{point.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card note note--accent">
    <h2 class="section-heading section-heading--sm">{p.clearHeading}</h2>
    <p class="note-body">{p.clearBody}</p>
    <p class="muted note-body note-body--last">
      {p.clearBodyAfter}<a href={href('about/')}>{p.clearLink}</a>.
    </p>
  </section>
</Base>
