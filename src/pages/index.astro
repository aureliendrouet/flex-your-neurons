---
/**
 * Language chooser at the site root.
 *
 * GitHub Pages serves static files and cannot negotiate content, so the choice happens in
 * the browser: a previously chosen language wins, otherwise `navigator.languages` decides,
 * otherwise English. A `<noscript>` meta-refresh and real links cover the cases where the
 * script never runs — the site must never be a dead end.
 */
import { dict, LOCALES, localeOptions } from '../lib/i18n';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const languages = localeOptions();
const en = dict('en').pages.redirect;
const fr = dict('fr').pages.redirect;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reason — reasoning-test training</title>
    <meta name="description" content="Training on reasoning-test item formats. Entraînement aux formats des tests de raisonnement." />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={`${base}/${l}/`} />)}
    <link rel="alternate" hreflang="x-default" href={`${base}/en/`} />
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${base}/en/`} />
    </noscript>
    <script is:inline define:vars={{ base, locales: LOCALES }}>
      // Runs before paint so the chooser below is never seen in the normal case.
      (function () {
        var target = 'en';
        try {
          var stored = localStorage.getItem('iq:v1:locale');
          if (stored && locales.indexOf(stored) >= 0) {
            target = stored;
          } else {
            var preferred = navigator.languages || [navigator.language || 'en'];
            for (var i = 0; i < preferred.length; i++) {
              var primary = String(preferred[i]).toLowerCase().split('-')[0];
              if (locales.indexOf(primary) >= 0) {
                target = primary;
                break;
              }
            }
          }
        } catch (e) {
          // localStorage can throw in private mode; English is a safe default.
        }
        location.replace(base + '/' + target + '/');
      })();
    </script>
  </head>
  <body>
    <main class="shell chooser">
      <h1 class="chooser-title" data-testid="redirect-title">{en.title}</h1>
      <p class="muted flush">{en.body}</p>
      <p class="muted flush" lang="fr">{fr.body}</p>
      <div class="cluster">
        {
          languages.map((l) => (
            <a class="btn btn-lg" href={`${base}/${l.locale}/`} hreflang={l.locale} lang={l.locale} data-testid={`choose-${l.locale}`}>
              {l.nativeName}
            </a>
          ))
        }
      </div>
    </main>
  </body>
</html>
