---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { dict, localeOptions, pathForLocale, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Rendered under the page heading. */
  lede?: string;
  /**
   * Root-relative path to this page's social card, e.g. `/iq/en/og/matrix.svg`.
   * Omit and the page previews as title and description alone, as before.
   */
  ogImage?: string;
}

const { locale, title, description, lede, ogImage } = Astro.props;
const t = dict(locale);

const base = import.meta.env.BASE_URL;
const root = base.replace(/\/$/, '');
/** Locale-aware in-app link: href('practice/') -> /iq/fr/practice/ */
const href = (path: string) => `${root}/${locale}/${path}`;

const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (path: string) => current === href(path).replace(/\/$/, '');

const NAV = [
  { path: '', label: t.nav.home, key: 'home' },
  { path: 'practice/', label: t.nav.practice, key: 'practice' },
  { path: 'test/', label: t.nav.test, key: 'test' },
  { path: 'progress/', label: t.nav.progress, key: 'progress' },
  { path: 'about/', label: t.nav.about, key: 'about' },
];

const languages = localeOptions();
---

<!doctype html>
<html lang={t.locale.htmlLang} data-base={base} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {
      /* Self-hosted, subsetted at build time. Only the display face is preloaded: it draws
         the h1, which is above the fold on every page, whereas preloading both would make
         two requests compete with the one that matters. The text role is the system stack
         and needs no download at all — see astro.config.mjs. */
    }
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-code" />
    <link rel="icon" href={`${root}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    {
      /* Absolute, because crawlers do not resolve relative og:image URLs. `Astro.site` is
         the configured production origin, so this stays correct behind the base path. */
      ogImage && (
        <>
          <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
          <meta property="og:image:type" content="image/svg+xml" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {
      /* Tell search engines the pages are translations of one another, and which one to
         serve when the reader's language is unknown. */
      languages.map((l) => (
        <link
          rel="alternate"
          hreflang={l.locale}
          href={`${root}/${l.locale}${Astro.url.pathname.replace(`${root}/${locale}`, '')}`}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${root}/en${Astro.url.pathname.replace(`${root}/${locale}`, '')}`}
    />
  </head>
  <body>
    <a href="#main" class="sr-only">{t.nav.skipToContent}</a>

    {
      /* Scroll sentinel. The header's scrolled state is driven by whether this zero-height
         element is still in view — an IntersectionObserver fires twice in a session, whereas
         a scroll listener fires on every frame of every scroll for the same information. */
    }
    <div id="scroll-sentinel" aria-hidden="true"></div>

    <header class="site-header">
      <div class="shell header-bar">
        <a href={href('')} class="wordmark" data-testid="wordmark">
          <span aria-hidden="true" class="wordmark-mark">▦</span>
          <span class="wordmark-text">{t.nav.brand}</span>
        </a>

        <div class="header-controls">
          <nav aria-label={t.nav.mainNav} class="nav">
            {
              NAV.map((link) => (
                <a
                  href={href(link.path)}
                  class="nav-link"
                  aria-current={isCurrent(link.path) ? 'page' : undefined}
                  data-testid={`nav-${link.key}`}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>

          <div
            role="group"
            aria-label={t.nav.languageLabel}
            data-testid="language-switcher"
            class="lang-switch"
          >
            {
              languages.map((l) => (
                <a
                  href={pathForLocale(Astro.url.pathname, l.locale, base)}
                  class="lang-link"
                  hreflang={l.locale}
                  lang={l.locale}
                  data-testid={`lang-${l.locale}`}
                  aria-current={l.locale === locale ? 'true' : undefined}
                  title={l.locale === locale ? undefined : t.nav.switchTo(l.nativeName)}
                >
                  {l.locale}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </header>

    <main id="main" class="shell page-main">
      <div class="page-head" data-has-hero={Astro.slots.has('hero') ? 'true' : undefined}>
        {
          /* Optional decoration behind the heading. Only the home page uses it: on a page
             whose job is comprehension, a figure behind the words would compete with them. */
          Astro.slots.has('hero') && (
            <div class="page-hero" aria-hidden="true">
              <slot name="hero" />
            </div>
          )
        }
        <h1 class="page-title">{title}</h1>
        {lede && <p class="muted page-lede">{lede}</p>}
      </div>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell subtle footer-inner">
        <p>{t.footer.generated}</p>
        <p>
          {t.footer.noScore} <a href={href('about/')}>{t.footer.whyItMatters}</a>.
        </p>
        <p>
          <a href={href('terms/')} data-testid="footer-terms">{t.footer.terms}</a>
        </p>
      </div>
    </footer>

    <script>
      // Remember the language the reader is actually using, so the root URL can send
      // them straight back here next time instead of re-negotiating from scratch.
      try {
        const chosen = document.documentElement.dataset.locale;
        if (chosen) localStorage.setItem('iq:v1:locale', chosen);
      } catch {
        // Private-browsing modes can throw on localStorage access; the site works without it.
      }

      /*
       * `data-scrolled` on <html>, so the sticky header can tell "at rest at the top of the
       * page" from "floating over content" and earn its shadow and its brighter rule only in
       * the second case.
       *
       * An observer on a sentinel rather than a scroll listener: this needs to know one
       * boolean, which changes twice, and a scroll handler would recompute it on every frame
       * of every scroll. The whole effect degrades to a plain bordered header if the script
       * never runs.
       */
      const sentinel = document.getElementById('scroll-sentinel');
      if (sentinel && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          (entries) => {
            const atTop = entries[entries.length - 1]?.isIntersecting ?? true;
            document.documentElement.toggleAttribute('data-scrolled', !atTop);
          },
          { threshold: 0 },
        ).observe(sentinel);
      }
    </script>
  </body>
</html>
